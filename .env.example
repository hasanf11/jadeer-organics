# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — never expose this key in the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# The public address of the shop (used for SEO links and order links)
SITE_URL=https://www.jadeerorganics.com

# Emails (optional) — https://resend.com
RESEND_API_KEY=
ORDER_EMAIL_FROM=Ja'deer Organics <orders@jadeerorganics.com>
# Where new-order and contact-message alerts are sent
SHOP_NOTIFY_EMAIL=
